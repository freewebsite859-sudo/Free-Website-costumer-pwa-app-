# Nexora Customer PWA — Supabase configuration
# Copy this file to .env and fill in the values. NEVER commit .env.
#
# The shared Nexora Supabase project (locked): qwaehqsmodekbgvnaavz
# The app refuses any other project (hostname is validated at startup).
#
# Supabase Dashboard → Project qwaehqsmodekbgvnaavz → Settings → API:
#   - Project URL            → VITE_SUPABASE_URL
#   - anon / publishable key → VITE_SUPABASE_ANON_KEY

VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_REAL_ANON_KEY_HERE

# Optional: server-side Gemini key for the /api/suggest-times helper.
GEMINI_API_KEY=
