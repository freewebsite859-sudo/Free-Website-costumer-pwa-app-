# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Dashboard > Project Settings > Data API  (and > API Keys for the anon key)
#
# Only the *anon* (publishable) key belongs in a browser app. Every table is
# protected by Row Level Security, so this key cannot read other users' data.
# NEVER put the service_role key in a VITE_ variable - Vite inlines those into
# the public bundle.
#
# If these are left unset the app still runs, but in local-only demo mode:
# data stays in this browser and accounts are unavailable.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# ---------------------------------------------------------------------------
# Optional - only needed if you add server-side Gemini features
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
